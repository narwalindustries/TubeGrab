{
  "name": "tubegrab",
  "productName": "TubeGrab",
  "version": "1.0.0",
  "description": "YouTube-style web tool with per-video download options (video + audio) powered by yt-dlp",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "desktop": "electron .",
    "encrypt": "node tools/encrypt-config.js"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "express": "^4.19.2",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "electron": "^44.7.2"
  },
  "build": {
    "appId": "com.tubegrab",
    "productName": "TubeGrab",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "public/logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TubeGrab"
    }
  }
}
