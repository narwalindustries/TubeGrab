# =========================================================
# TubeGrab Environment Configuration Template
# =========================================================
# Copy this file to .env and set your private configuration.
# The .env file is strictly ignored by git and will NEVER be uploaded to GitHub.

# Server listening port (default: 3000 locally, 10000 on Render)
PORT=3000

# Secret API Key Protection:
# Set a custom secret key to ensure ONLY your frontend can access your backend.
# If configured, any unauthorized request without this key gets rejected (401 Unauthorized).
API_SECRET_KEY=

# Render or Cloud Backend URL:
# Example: https://your-service.onrender.com
BACKEND_URL=

# Optional path to cookies.txt (Never uploaded to GitHub)
YT_COOKIES=cookies.txt

# Maximum concurrent background download jobs
MAX_JOBS=3
